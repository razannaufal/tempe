{
  "name": "tempe-cli",
  "version": "1.0.0",
  "description": "Tempe CLI - Terminal AI Coding Agent with dynamic mascot, multi-API key, auto-language detection, and usage tracking",
  "repository": {
    "type": "git",
    "url": "https://github.com/razannnaufal/tempe-cli.git"
  },
  "main": "dist/index.js",
  "bin": {
    "tempe": "bin/tempe.js"
  },
  "files": [
    "bin/tempe.js",
    "dist/index.js",
    "dist/agent/",
    "dist/core/",
    "dist/mascot/",
    "dist/providers/",
    "dist/ui/",
    "templates/",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:windows": "npm run build && node scripts/build-windows.js",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "start": "node bin/tempe.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "terminal",
    "opencode",
    "tempe"
  ],
  "author": "Tempe AI Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
